# зависимости и сборка
node_modules/
dist/
out/

# Записываемое состояние приложения. С 2026-07-25 живёт в userData, но старое ещё лежит
# тут: карта порталов, настройки, журналы и снимки экрана — личные данные разработчика,
# им не место ни в репозитории, ни в установщике (в сборку не попадает по !data/**).
app/data/
app/out/
.env
.env.*
!.env.example
*.pcap
*.pcapng
.claude/

# Снятая для отладки копия того же состояния из %APPDATA%. Внутри auth.json с id
# аккаунта и токеном продления, карта порталов и снимки экрана. Папка появляется
# руками и лежит в корне репозитория — то есть один `git add .` отправляет токен
# в открытый репозиторий. Правило важнее прочих: остальные берегут вес и приватность,
# это бережёт учётную запись.
_appdata-live-state/

# Тяжёлые входные данные генераторов: нужны только tools/, не рантайму.
# world-raw.json — 20 МБ сырого дампа мира, из него делаются world-adjacency.json,
# world-positions.json и тиры зон королевства (tools/add-royal-tiers.js).
world-raw.json
roadinator-maplist.json
research-eve-tools.json
calibration/

# Черновой этап 0: отдельный прогон распознавания со своей копией traineddata (9,8 МБ).
# Своё дело сделал, в приложение не входит и в репозитории только весит.
etap0/

# Отчёты аудитов и ревью: рабочие документы с абсолютными путями и именем пользователя
# Windows. Полезны на диске, но в открытом репозитории это лишние сведения о машине.
AUDIT-*.md
REVIEW-*.md

# отладочные артефакты
*.log
build/icon-32.png

# Личные полные кадры для локальных регрессионных проверок не публикуются.
app/test/fixtures/portal-recovery-*.png
app/test/fixtures/portal-recovery-cases.json
app/test/fixtures/portal-recovery-provenance.md

# Рабочие исследования, отчёты и инструменты оператора остаются на компьютере.
concepts/
tools/experiments/
tools/discord-community/
tools/prepare-private-collectors.cjs
tools/install-private-collectors.cjs
tools/check-private-ingest.cjs
tools/check-collector-ingest.cjs
tools/collector-main-smoke.cjs
tools/prepare-release-audit.cjs
tools/release-live-access-review.cjs
docs/final-audit-*.md
docs/site-launch-*.md
docs/server-*-2026-*.md
docs/*-review.md
docs/payments/
docs/releases/0.5.1[0-9].md

# Производные адаптеры создаются из исходников приложения при сборке сайта.
site-source/src/cloud/generated/
